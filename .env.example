# Local paths for configs (KEY=value). Copied/loaded by ./scripts/train.sh.
# cp .env.example .env  &&  edit paths below.

DATA_ROOT=/path/to/sasv_pairs
OUTPUT_DIR=./outputs
SALMONN_CKPT=/path/to/salmonn_7b_v0.pth
LLAMA_PATH=/path/to/vicuna-7b-v1.1
WHISPER_PATH=/path/to/whisper-large-v2
BEATS_PATH=/path/to/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2.pt

